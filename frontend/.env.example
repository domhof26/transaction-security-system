# Base URL for static n8n webhook endpoints
N8N_API_BASE_URL=http://localhost:5678/webhook

# Full production webhook URLs for dynamic parameterized endpoints
N8N_WF07_RECEIPT_URL=http://localhost:5678/webhook/{node-id}/api/receipts/:id
N8N_WF07_REGISTER_RECEIPTS_URL=http://localhost:5678/webhook/{node-id}/api/registers/:id/receipts
N8N_WF08_AUDIT_LIST_URL=http://localhost:5678/webhook/api/audit
N8N_WF08_AUDIT_EVENT_URL=http://localhost:5678/webhook/{node-id}/api/audit/events/:id
N8N_WF11_ERRORS_URL=http://localhost:5678/webhook/api/errors

# Server-side Supabase read access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
